from http.server import BaseHTTPRequestHandler, HTTPServer

class WebServer(BaseHTTPRequestHandler):
    def do_GET(self):
        # Respondemos con un código 200 (OK)
        self.send_response(200)
        # Indicamos que lo que sigue es código HTML
        self.send_header("Content-type", "text/html")
        self.end_headers()
        # El contenido de la página
        self.wfile.write(bytes("<html><body><h1>Hola Mundo!!!</h1><p>Servidor desde Raspberry Pi</p></body></html>", "utf-8"))
     	




def main():
    # Escuchamos en la IP de la Raspberry y el puerto 80
    webServer = HTTPServer(("192.168.1.254", 80), WebServer)
    print("Servidor iniciado")
    print("\tAtendiendo solicitudes entrantes en http://192.168.1.254")
    try:
        webServer.serve_forever()
    except KeyboardInterrupt:
        pass
    webServer.server_close()
    print("Server stopped.")

if __name__ == "__main__":
    main()
